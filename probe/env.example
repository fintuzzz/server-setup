# Цели через точку с запятой: «Имя=адрес:порт,порт» (TCP) или «Имя=https://домен/страница» (должна ответить 200).
# На реле не проверяйте домен конфигов: он указывает на этот же сервер, и пересылка реле к своим запросам не применяется.
PROBE_TARGETS=Узел=203.0.113.7:443,8443;Кабинет=https://lk.example.com/healthz

# Одна цель, прежняя настройка; используется, если PROBE_TARGETS пуст.
# PROBE_TARGET=vpn.example.com

# Telegram: токен бота, от имени которого придут тревоги, и ID получателей через запятую.
# Лучше завести отдельного бота в @BotFather; получатель должен нажать у него /start.
TG_BOT_TOKEN=
TG_CHAT_IDS=

# На реле: Telegram отсюда закрыт, сообщения идут через передатчик на узле по туннелю шлюза. TLS до самого Telegram.
# Сначала пробуется этот путь, затем прямой. Без шлюза не заработает.
TG_VIA=10.78.0.1:8444

# Команда /status: подключения клиентов и серверы по данным сервера управления. Токен тот же, что MONITOR_PROBE_TOKEN
# в .env сервера управления (там же MONITOR_PROBE_IP с адресом этого хоста). Пусто: /status покажет только проверки зонда.
PROBE_STATUS_URL=
PROBE_STATUS_TOKEN=

# Необязательно (значения по умолчанию):
# PROBE_NAME=РФ                 подпись точки наблюдения в сообщении
# PROBE_PORTS=443               порты PROBE_TARGET через запятую; цель доступна, если отвечает хотя бы один
# PROBE_STATE_FILE=             файл, в котором сбои за 7 дней переживают перезапуск
# PROBE_INTERVAL=60             секунд между проверками
# PROBE_FAIL_AFTER=3            неудач подряд до тревоги
# PROBE_OK_AFTER=2              успехов подряд до отбоя
# PROBE_REMIND_HOURS=6          напоминать о недоступности раз в N часов (0 — не напоминать)
# PROBE_CONTROLS=ya.ru:443,vk.com:443   контрольные сайты: если не отвечают и они, неполадка у самого зонда
# TG_API=https://api.telegram.org       если Telegram с этого хоста доступен только через свой прокси-адрес
